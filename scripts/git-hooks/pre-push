#!/bin/sh
# Inspect the destination ref; the source branch may have a different name.
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/develop|refs/heads/main)
      printf 'BinFlow: direct push to %s blocked. Use an approved release PR.\n' "$remote_ref" >&2
      exit 1
      ;;
  esac
done
exit 0
