OPENAI_API_KEY=your_openai_api_key_here
PORT=3001
CORS_ORIGIN=http://localhost:5173,https://getbinflow.com,https://www.getbinflow.com

# Supabase project settings. Use the project URL and publishable/anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# Backend only. Required for employee creation and scanner operations under strict employee RLS.
# Never expose this value in a VITE_ variable or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Weekly admin email summaries. Verify the sender domain in Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=BinFlow <summaries@your-domain.com>
BINFLOW_APP_URL=https://getbinflow.com
WEEKLY_SUMMARY_CRON_SECRET=generate_a_long_random_secret

# Frontend settings.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
