# Copy to .env.billing.local (ignored). ALL values below are local/test only.
BILLING_ENABLED=true
BILLING_DATABASE_URL=postgresql://postgres:replace-with-local-db-password@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-key
VITE_API_URL=http://localhost:3001
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_ANNUAL_PRICE_ID=
STRIPE_PRICE_ID=price_replace
BILLING_TRIAL_IDENTITY_SECRET=replace-with-a-stable-random-secret-at-least-32-characters
BILLING_TRIAL_DAYS=30
BILLING_WEB_URL=http://localhost:5173/app/
OPENAI_API_KEY=
PORT=3001
# Database billing_policy.mode is authoritative, not the legacy env mode.
# No native external purchase links are enabled by default.
VITE_BILLING_IOS_EXTERNAL_PURCHASE_ENABLED=false
VITE_BILLING_ANDROID_EXTERNAL_PURCHASE_ENABLED=false
VITE_BILLING_NATIVE_POLICY_REVIEW=
VITE_BILLING_EXTERNAL_WEBSITE_URL=https://getbinflow.com/app/

# Optional. Enable only on an approved API with the iOS handoff migration and web UI.
BILLING_IOS_HANDOFF_ENABLED=false
