{
  "name": "grain-ticket-scanner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "start:rollback": "node server/release-rollback.js",
    "server": "node server/index.js",
    "client": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:mobile-env": "node scripts/check-mobile-env.js",
    "prebuild:mobile": "npm run check:mobile-env",
    "build:mobile": "vite build --mode mobile --config vite.mobile.config.js",
    "preview": "vite preview --host 0.0.0.0",
    "check:mobile-bundle": "node scripts/check-mobile-bundle.js",
    "check:account-sql": "node scripts/check-account-deletion-sql.mjs",
    "check:account-concurrency": "node scripts/check-account-concurrency.mjs",
    "check:account-staging": "node scripts/check-account-staging.mjs",
    "check:grain-concurrency": "node scripts/check-grain-concurrency.mjs",
    "check:grain-staging": "node scripts/check-grain-staging.mjs",
    "check:invitation-staging": "node scripts/check-invitation-staging.mjs",
    "check:release-compatibility": "node scripts/check-release-compatibility.mjs",
    "check:release-staging": "node scripts/check-release-staging.mjs",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:sync:ios": "npm run build:mobile && cap sync ios",
    "cap:open:ios": "cap open ios",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "openai": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@electric-sql/pglite": "^0.5.10",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.5",
    "pg": "^8.23.1",
    "vite": "^7.3.7"
  }
}
